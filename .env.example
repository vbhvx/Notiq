# Database (PostgreSQL) — use a hosted provider like Neon, Supabase, or Railway
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# NextAuth — generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# NextAuth URL — your production domain (update for deployment)
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini API Key — get from https://aistudio.google.dev
GEMINI_API_KEY="your-gemini-api-key"

# Node environment
NODE_ENV="development"
