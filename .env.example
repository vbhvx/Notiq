# Database (PostgreSQL) — use a hosted provider like Neon, Supabase, or Railway
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Optional: pin notes to a specific user ID (auto-created on first request if omitted)
# DEFAULT_USER_ID="your-user-id"
# DEFAULT_USER_NAME="Notiq"

# Google Gemini API Key — get from https://aistudio.google.dev
GEMINI_API_KEY="your-gemini-api-key"

# Node environment
NODE_ENV="development"
